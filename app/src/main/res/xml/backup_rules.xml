<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The detection log can contain location history and the
     device list reveals where you've been, so keep them out of cloud backups. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <!-- Encrypted with a Keystore key that never leaves this phone: useless elsewhere. -->
    <exclude domain="sharedpref" path="secure_store.xml" />
</full-backup-content>
