<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The detection log can contain location history, so it never goes
     to cloud backup. Direct phone-to-phone transfer still carries it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <!-- Encrypted with a Keystore key that never leaves this phone: useless elsewhere. -->
        <exclude domain="sharedpref" path="secure_store.xml" />
        <!-- Home, Work, starred and recent destinations: addresses stay on this phone. -->
        <exclude domain="sharedpref" path="nav_places.xml" />
        <!-- Sentinel Link: this phone's own id and its group; a copy would make two phones the same Sentinel. -->
        <exclude domain="sharedpref" path="sentinel_link.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="secure_store.xml" />
        <exclude domain="sharedpref" path="sentinel_link.xml" />
    </device-transfer>
</data-extraction-rules>
