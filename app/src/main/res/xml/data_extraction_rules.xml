<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The detection log can contain location history, so it never goes
     to cloud backup. Direct phone-to-phone transfer still carries it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
