<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The app's type scale: every screen picks one of these, so the same kind of text is the same size
        everywhere. The map's driving overlay and the home-screen widget keep their own sizes for glancing.
    -->
    <dimen name="text_caption">12sp</dimen>   <!-- hints, timestamps, small print -->
    <dimen name="text_body">14sp</dimen>      <!-- normal text, secondary lines -->
    <dimen name="text_subtitle">16sp</dimen>  <!-- list item titles, emphasised lines -->
    <dimen name="text_title">20sp</dimen>     <!-- screen and card titles -->
    <dimen name="text_headline">24sp</dimen>  <!-- big headings -->
    <dimen name="text_display">34sp</dimen>   <!-- one big number -->
</resources>
