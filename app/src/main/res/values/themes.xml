<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DarkActionBar (not NoActionBar): the activities rely on the window action bar
         for their titles and MainActivity's overflow menu.
         Light / Dark / System all use this theme; ThemeManager forces the night mode. -->
    <style name="Theme.RFSentinel" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="rfScopeColor">@color/scope</item>
        <item name="rfScopeTextColor">@color/scope_text</item>
        <item name="rfTraceColor">@color/trace</item>
        <item name="rfAccent">@color/brand_highlight</item>
        <item name="rfOnAccent">@color/brand_on_highlight</item>
    </style>

    <!-- Material You: Material 3 components; colours come from the wallpaper
         (DynamicColors, Android 12+), falling back to the M3 baseline palette. -->
    <style name="Theme.RFSentinel.MaterialYou" parent="Theme.Material3.DayNight">
        <!-- Selected chips / toggles use this theme's own primary colour. -->
        <item name="rfAccent">?attr/colorPrimary</item>
        <item name="rfOnAccent">?attr/colorOnPrimary</item>
        <item name="rfScopeColor">?attr/colorPrimary</item>
        <item name="rfScopeTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="rfTraceColor">?attr/colorTertiary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.ActionBar</item>
    </style>

    <!-- DedSec-inspired hacktivist zine: black and white, hot pink and violet, monospace. -->
