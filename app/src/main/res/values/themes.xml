        <!-- Selected chips / toggles use this theme's own primary colour. -->
        <item name="rfAccent">?attr/colorPrimary</item>
        <item name="rfOnAccent">?attr/colorOnPrimary</item>
        <item name="colorPrimary">@color/dedsec_magenta</item>
        <item name="colorPrimaryVariant">@color/dedsec_black</item>
        <item name="colorOnPrimary">@color/dedsec_black</item>
        <item name="colorSecondary">@color/dedsec_violet</item>
        <item name="colorOnSecondary">@color/dedsec_text</item>
        <item name="colorSurface">@color/dedsec_panel</item>
        <item name="colorOnSurface">@color/dedsec_text</item>
        <item name="android:colorBackground">@color/dedsec_black</item>
        <item name="android:windowBackground">@color/dedsec_black</item>
        <item name="android:textColorPrimary">@color/dedsec_text</item>
        <item name="android:textColorSecondary">@color/dedsec_dim</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
        <item name="fontFamily">@font/share_tech_mono</item>
        <item name="android:statusBarColor">@color/dedsec_black</item>
        <item name="android:navigationBarColor">@color/dedsec_black</item>
        <item name="actionBarStyle">@style/DedSec.ActionBar</item>
        <item name="actionBarTheme">@style/DedSec.ActionBarOverlay</item>
        <item name="alertDialogTheme">@style/DedSec.Dialog</item>
        <item name="materialAlertDialogTheme">@style/DedSec.Dialog</item>
        <item name="rfScopeColor">@color/dedsec_magenta</item>
        <item name="rfScopeTextColor">@color/dedsec_dim</item>
        <item name="rfTraceColor">@color/dedsec_violet</item>
        <item name="colorAccent">@color/dedsec_violet</item>
    </style>

    <style name="DedSec.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/dedsec_black</item>
        <item name="titleTextStyle">@style/DedSec.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="DedSec.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/dedsec_text</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DedSec.ActionBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/dedsec_text</item>
        <item name="android:textColorPrimary">@color/dedsec_text</item>
    </style>

    <style name="DedSec.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/dedsec_magenta</item>
        <item name="colorSurface">@color/dedsec_panel</item>
        <item name="android:background">@color/dedsec_panel</item>
        <item name="android:textColorPrimary">@color/dedsec_text</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
    </style>

    <!-- Shared pieces for the styled themes: colours come from the theme's attrs. -->
    <style name="Styled.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">?attr/rfBarColor</item>
        <item name="titleTextStyle">@style/Styled.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Styled.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">?attr/rfTitleColor</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Styled.ActionBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">?attr/rfTitleColor</item>
        <item name="android:textColorPrimary">?attr/rfTitleColor</item>
    </style>

    <style name="Styled.ActionBarOverlay.Light" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">?attr/rfTitleColor</item>
