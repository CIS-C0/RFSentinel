<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tagText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/presenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption" />

        <!-- Your own note on the device: tap to edit -->
        <TextView
            android:id="@+id/noteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- Visual style: hot / cold signal dial and the match's confidence ring -->
        <LinearLayout
            android:id="@+id/visualTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.rfsentinel.app.ui.SignalGaugeView
                android:id="@+id/gauge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6" />

            <com.rfsentinel.app.ui.ConfidenceRingView
                android:id="@+id/ring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Live signal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rssiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="@dimen/text_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rssiDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <com.rfsentinel.app.ui.SignalGraphView
            android:id="@+id/graph"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp" />

        <!-- The two main actions up front, side by side (same height when a label wraps) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locateButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Locate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionWatchlist"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Add to watchlist" />
        </LinearLayout>

        <!-- The other actions -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/actionWhitelist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whitelist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorite" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionRename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rename" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add note" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionLearn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I saw it" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionSightings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sightings map" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy address" />

            <com.google.android.material.chip.Chip
                android:id="@+id/actionShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share report" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Rebuilt when the device's details change -->
        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Everything on this screen comes from signals the device broadcasts publicly. RF Sentinel never connects to it. Distance is a rough estimate from signal strength."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
