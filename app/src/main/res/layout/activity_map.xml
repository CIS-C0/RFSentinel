<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3D view: the map is tilted, so its own attribution can be off screen; this one stays. -->
    <TextView
        android:id="@+id/osmCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:background="#99FFFFFF"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#333333"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Status card, with the camera-download progress bar under it -->
    <LinearLayout
        android:id="@+id/statusBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_bg"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/downloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="#FFFFFF"
            app:trackColor="#660B5C63"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <!-- Bottom: follow button, device filter chips, controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

    <!-- On the main screen: open the map full screen. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fullscreenButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Open the map full screen"
        android:src="@drawable/ic_fullscreen"
        android:visibility="gone"
        app:fabSize="mini"
        app:tint="#FFFFFF" />

    <!-- Light / dark map. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/themeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Light / dark map"
        android:src="@drawable/ic_dark_mode"
        app:fabSize="mini"
        app:tint="#FFFFFF" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/orientationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Map: north up"
        android:src="@drawable/ic_north_up"
        app:fabSize="mini"
        app:tint="#FFFFFF" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/centerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Follow my position"
        android:src="@drawable/ic_my_location"
        app:fabSize="mini"
        app:tint="#FFFFFF" />

    <HorizontalScrollView
        android:id="@+id/mapFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/mapFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.3"
            android:text="Record trace"
            app:icon="@drawable/ic_record" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tracesButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Traces" />
    </LinearLayout>
    </LinearLayout>

    <!-- On the main screen: Record / Traces as round buttons on the map (the bar above is hidden). -->
    <LinearLayout
        android:id="@+id/compactControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/recordFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="Record trace"
            android:src="@drawable/ic_record"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/tracesFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Traces"
            android:src="@drawable/ic_car_history"
            app:fabSize="mini" />

    </LinearLayout>
</FrameLayout>
