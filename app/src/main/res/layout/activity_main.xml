<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Styled-theme header: optional user banner image + animated wordmark. -->
    <LinearLayout
        android:id="@+id/themedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/themeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Theme banner"
            android:maxHeight="140dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.rfsentinel.app.ui.ThemeHeaderView
            android:id="@+id/themeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/threatBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/banner_bg"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Idle"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStopButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="Start scanning"
            app:icon="@drawable/ic_car_play"
            app:iconGravity="textStart" />

        <!-- List / radar: a two-way toggle reads clearer than one button naming the other view. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/viewToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewListButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="List view"
                android:minWidth="56dp"
                android:minHeight="52dp"
                app:icon="@drawable/ic_car_list"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewRadarButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Radar view"
                android:minWidth="56dp"
                android:minHeight="52dp"
                app:icon="@drawable/ic_radar"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- The map (traces, devices, known cameras), right beside the list / radar views. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Open the map: your traces, devices and known cameras"
            android:minWidth="56dp"
            android:minHeight="52dp"
            app:icon="@drawable/ic_map"
            app:iconPadding="0dp" />

        <!-- Tools: cell towers, WiFi channels and spectrum. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolsButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Tools: cell towers, WiFi channels and WiFi spectrum"
            android:minWidth="56dp"
            android:minHeight="52dp"
            app:icon="@drawable/ic_tools"
            app:iconPadding="0dp" />
    </LinearLayout>

    <!-- Device filters (built in code from DeviceFilter, with live counts). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <com.rfsentinel.app.ui.RadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="No devices heard yet.\nTap a device for full details.\nLong-press for quick actions (watchlist, whitelist, favorite)."
            android:textColor="#888888" />

    </FrameLayout>

    <!-- Hidden while the list is scrolled down; back when it returns to the top. -->
    <TextView
        android:id="@+id/disclaimerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="@string/disclaimer"
        android:textColor="#888888"
        android:textSize="10sp" />

</LinearLayout>
