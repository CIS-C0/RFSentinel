<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/scopeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/scopeDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true" />

        <RadioButton
            android:id="@+id/scopePrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Prefix length in bits, one hex digit (4 bits) per step: shown while the prefix is picked. -->
        <com.google.android.material.slider.Slider
            android:id="@+id/prefixBitsSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:contentDescription="Prefix length in bits"
            android:stepSize="4"
            android:valueFrom="24"
            android:valueTo="44"
            android:visibility="gone" />

        <RadioButton
            android:id="@+id/scopeFingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <RadioButton
            android:id="@+id/scopeShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <RadioButton
            android:id="@+id/scopeStarts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </RadioGroup>

    <EditText
        android:id="@+id/startsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:hint="Start of the name"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:visibility="gone" />

    <TextView
        android:id="@+id/warningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/match_tag_bg"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <EditText
        android:id="@+id/labelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Label (what this device is)"
        android:importantForAutofill="no"
        android:inputType="text" />
</LinearLayout>
