<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, in foldable sections (header + section; SettingsActivity folds them and adds the ⓘ details). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/SettingsControl"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= General ================= -->
        <TextView android:id="@+id/headerGeneral" style="@style/SettingsHeader" android:paddingTop="4dp" android:text="General" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionGeneral" android:orientation="vertical">

            <Button
                android:id="@+id/runSetupButton"
                style="@style/SettingsOutlinedButton"
                android:text="Run the setup wizard again" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/autoUpdateSwitch"
                android:text="Check for updates on app open" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/prereleaseSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Include prerelease builds" />

            <Button
                android:id="@+id/checkUpdateButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Check for updates" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/discreetSwitch"
                android:text="Discreet mode" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/fullscreenSwitch"
                android:text="Fullscreen" />

            <TextView android:id="@+id/screenLabel" style="@style/SettingsLabel" android:text="Screen while the app is open" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/screenModeGroup">

                <RadioButton style="@style/SettingsControl" android:id="@+id/screenAlwaysOn" android:text="Always on" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/screenOnCharging" android:text="On while charging" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/screenNormal" android:text="Normal" />
            </RadioGroup>

            <TextView android:id="@+id/rotationLabel" style="@style/SettingsLabel" android:text="Screen rotation" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/rotationGroup">

                <RadioButton style="@style/SettingsControl" android:id="@+id/rotationNormal" android:text="Normal" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/rotationAllWays" android:text="Auto-rotate, upside down too" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/rotationUpsideDown" android:text="Always upside down" />
            </RadioGroup>
        </LinearLayout>

        <!-- ================= Appearance ================= -->
        <TextView android:id="@+id/headerAppearance" style="@style/SettingsHeader" android:text="Appearance" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionAppearance" android:orientation="vertical">

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/themeGroup" />

            <TextView android:id="@+id/bannerLabel" style="@style/SettingsLabel" android:text="Banner image" />

            <LinearLayout
                style="@style/SettingsControl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bannerPickButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Choose image" />

                <Button
                    android:id="@+id/bannerClearButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remove image" />
            </LinearLayout>

            <TextView android:id="@+id/listSizeLabel" style="@style/SettingsLabel" android:text="List size" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/listSizeGroup">

                <RadioButton style="@style/SettingsControl" android:id="@+id/listSizeRegular" android:text="Regular" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/listSizeCompact" android:text="Compact" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/listSizeDense" android:text="Dense" />
            </RadioGroup>
        </LinearLayout>

        <!-- ================= What to detect ================= -->
        <TextView android:id="@+id/headerDetect" style="@style/SettingsHeader" android:text="What to detect" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionDetect" android:orientation="vertical">

            <LinearLayout
                style="@style/SettingsControl"
                android:id="@+id/categoryContainer"
                android:orientation="vertical" />

            <TextView android:id="@+id/presetLabel" style="@style/SettingsLabel" android:text="Watchlist presets" />

            <CheckBox style="@style/SettingsControl" android:id="@+id/presetGlobal" android:text="Global" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetCanada" android:text="Canada" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetUs" android:text="United States" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetFrance" android:text="France" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetUk" android:text="United Kingdom" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetPortugal" android:text="Portugal" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetGermany" android:text="Germany" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetSpain" android:text="Spain" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetItaly" android:text="Italy" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetNetherlands" android:text="Netherlands" />
            <CheckBox style="@style/SettingsControl" android:id="@+id/presetSweden" android:text="Sweden" />
        </LinearLayout>

        <!-- ================= Scanning ================= -->
        <TextView android:id="@+id/headerScanning" style="@style/SettingsHeader" android:text="Scanning" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionScanning" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/bleSwitch"
                android:text="Bluetooth scanning" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/wifiSwitch"
                android:text="WiFi scanning" />

            <TextView android:id="@+id/scanModeLabel" style="@style/SettingsLabel" android:text="Bluetooth scan intensity" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/scanModeGroup">

                <RadioButton style="@style/SettingsControl" android:id="@+id/scanModeLowLatency" android:text="Maximum" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/scanModeBalanced" android:text="Balanced" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/scanModeLowPower" android:text="Battery saver" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/bleEaseSwitch"
                android:text="Ease off for Bluetooth audio" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/blePassiveSwitch"
                android:text="Listen-only Bluetooth scan" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/bleScreenOffAllSwitch"
                android:text="Hear every Bluetooth device with the screen off" />

            <TextView android:id="@+id/intervalLabel" style="@style/SettingsLabel" android:text="WiFi scan interval" />

            <EditText
                style="@style/SettingsControl"
                android:id="@+id/intervalInput"
                android:hint="30"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                android:id="@+id/wifiThrottleText"
                style="@style/SettingsLabel"
                android:paddingTop="2dp"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/wifiThrottleButton"
                style="@style/SettingsTextButton"
                android:text="Open Developer options" />

            <Button
                android:id="@+id/batteryButton"
                style="@style/SettingsTextButton"
                android:text="Allow background scanning" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/hideTrustedSwitch"
                android:text="Hide trusted devices" />
        </LinearLayout>

        <!-- ================= Auto-start ================= -->
        <TextView android:id="@+id/headerAutoStart" style="@style/SettingsHeader" android:text="Auto-start" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionAutoStart" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/bootSwitch"
                android:text="When the phone starts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/carAutoSwitch"
                android:text="In the car" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/carRecordSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Record a trace in the car" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/carMusicSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play music in the car" />

            <TextView
                android:id="@+id/carDevicesText"
                style="@style/SettingsLabel"
                android:paddingTop="2dp"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/carDevicesButton"
                style="@style/SettingsTextButton"
                android:text="Choose your car's Bluetooth" />

            <Button
                android:id="@+id/carMusicButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose music app" />
        </LinearLayout>

        <!-- ================= Trackers & followers ================= -->
        <TextView android:id="@+id/headerFollow" style="@style/SettingsHeader" android:text="Trackers &amp; followers" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionFollow" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/followSwitch"
                android:text="Warn when a device moves with me" />

            <LinearLayout
                style="@style/SettingsControl"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsLabel" android:text="For at least" />

                    <EditText
                        style="@style/SettingsControl"
                        android:id="@+id/followMinutesInput"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsLabel" android:text="Over" />

                    <EditText
                        style="@style/SettingsControl"
                        android:id="@+id/followMetersInput"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/trackerIgnoreText"
                style="@style/SettingsLabel"
                android:paddingTop="4dp"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/trackerIgnoreButton"
                style="@style/SettingsTextButton"
                android:text="Clear ignored trackers" />
        </LinearLayout>

        <TextView android:id="@+id/headerCameras" style="@style/SettingsHeader" android:text="Known cameras" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionCameras" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/knownAlprSwitch"
                android:text="Warn before plate-reader cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/speedCameraSwitch"
                android:text="Warn before speed / red-light cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/autoCamerasSwitch"
                android:text="Download cameras for the map area" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapCctvSwitch"
                android:text="Show CCTV cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapCctvPrivateSwitch"
                android:paddingStart="24dp"
                android:text="Include private and indoor CCTV" />

            <!-- Radius of "download the cameras around me" (also the setup wizard and the map menu). -->
            <TextView
                android:id="@+id/cameraRadiusText"
                style="@style/SettingsLabel"
                android:text="Download radius: 100 km" />

            <com.google.android.material.slider.Slider
                style="@style/SettingsControl"
                android:id="@+id/cameraRadiusSlider"
                android:contentDescription="Camera download radius in kilometres"
                android:stepSize="10"
                android:value="100"
                android:valueFrom="10"
                android:valueTo="200" />

            <Button
                android:id="@+id/prefetchCamerasButton"
                style="@style/SettingsTextButton"
                android:text="Download cameras around me" />

            <Button
                android:id="@+id/mapDeleteCamerasButton"
                style="@style/SettingsTextButton"
                android:text="Delete downloaded cameras" />

            <TextView
                android:id="@+id/prefetchCamerasText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/deflockButton"
                style="@style/SettingsTextButton"
                android:text="US &amp; Canada plate cameras · 18 MB" />

            <TextView
                android:id="@+id/deflockText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="@dimen/text_caption" />

            <!-- Cameras silenced from the map (tap a camera > Ignore alerts). -->
            <TextView
                android:id="@+id/ignoredCamerasText"
                style="@style/SettingsLabel"
                android:paddingTop="4dp"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/ignoredCamerasButton"
                style="@style/SettingsTextButton"
                android:text="Alert for all ignored cameras again" />
        </LinearLayout>

        <!-- ================= Cell network ================= -->
        <TextView android:id="@+id/headerCell" style="@style/SettingsHeader" android:text="Cell network" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionCell" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/cellChangeSwitch"
                android:text="Alert when the cell tower changes" />

            <TextView android:id="@+id/disable2gLabel" style="@style/SettingsLabel" android:text="Turn off 2G" />

            <Button
                android:id="@+id/disable2gButton"
                style="@style/SettingsTextButton"
                android:text="Open SIM settings" />

            <TextView android:id="@+id/cellSecurityLabel" style="@style/SettingsLabel" android:text="Network security alerts" />

            <Button
                android:id="@+id/cellSecurityButton"
                style="@style/SettingsTextButton"
                android:text="Open cellular security settings" />
        </LinearLayout>

        <!-- ================= Alerts ================= -->
        <TextView android:id="@+id/headerAlerts" style="@style/SettingsHeader" android:text="Alerts" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionAlerts" android:orientation="vertical">

            <TextView android:id="@+id/thresholdLabel" style="@style/SettingsLabel" android:text="Alert for matches that are at least" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/thresholdGroup">

                <RadioButton style="@style/SettingsControl" android:id="@+id/thresholdWeak" android:text="Weak" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/thresholdMedium" android:text="Probable" />
                <RadioButton style="@style/SettingsControl" android:id="@+id/thresholdStrong" android:text="Strong only" />
            </RadioGroup>

            <TextView android:id="@+id/dedupeLabel" style="@style/SettingsLabel" android:text="Re-alert the same device after" />

            <EditText
                style="@style/SettingsControl"
                android:id="@+id/dedupeInput"
                android:hint="5"
                android:importantForAutofill="no"
                android:inputType="number" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/soundSwitch"
                android:text="Alert sound" />

            <TextView android:id="@+id/alertVolumeLabel" style="@style/SettingsLabel" android:text="Alert volume" />

            <RadioGroup
                android:id="@+id/alertVolumeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/alertVolumeNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Navigation" />
                <RadioButton android:id="@+id/alertVolumeMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Media" />
                <RadioButton android:id="@+id/alertVolumeAlarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alarm" />
                <RadioButton android:id="@+id/alertVolumeNotification" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notification" />
                <RadioButton android:id="@+id/alertVolumeRing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ringtone" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/vibrateSwitch"
                android:text="Vibration" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/radarBeepSwitch"
                android:text="Radar-detector beeps" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/detectorSoundSwitch"
                android:text="Radar-detector sound" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/startupSweepSwitch"
                android:paddingStart="24dp"
                android:text="Start beep when a scan starts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gpsVoiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:text="Say GPS connected" />

            <Button
                android:id="@+id/detectorEffectButton"
                style="@style/SettingsTextButton"
                android:text="Detector sound effect" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/scanIntroSwitch"
                android:text="Intro sound when a scan starts" />

            <Button
                android:id="@+id/testIntroButton"
                style="@style/SettingsTextButton"
                android:text="Test intro" />

        </LinearLayout>

        <!-- ================= Voice ================= -->
        <TextView android:id="@+id/headerVoice" style="@style/SettingsHeader" android:text="Voice" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionVoice" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/voiceSwitch"
                android:text="Spoken alerts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/shortVoiceSwitch"
                android:text="Short spoken alerts" />

            <TextView style="@style/SettingsLabel" android:text="Voice speed" />

            <RadioGroup
                style="@style/SettingsControl"
                android:id="@+id/voiceRateGroup"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/voiceRateSlow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slow" />
                <RadioButton android:id="@+id/voiceRateNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" />
                <RadioButton android:id="@+id/voiceRateFast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast" />
            </RadioGroup>

            <TextView android:id="@+id/voiceBoostLabel" style="@style/SettingsLabel" android:text="Voice loudness" />

            <com.google.android.material.slider.Slider
                style="@style/SettingsControl"
                android:id="@+id/voiceBoostSlider"
                android:contentDescription="Extra loudness for spoken alerts, in decibels"
                android:stepSize="1"
                android:value="6"
                android:valueFrom="0"
                android:valueTo="15" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/voicePauseMusicSwitch"
                android:text="Pause music while an alert is spoken" />

            <LinearLayout
                style="@style/SettingsControl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voicePickButton"
                    style="@style/SettingsTextButton"
                    android:text="Choose voice" />

                <Button
                    android:id="@+id/voiceTestButton"
                    style="@style/SettingsTextButton"
                    android:text="Test voice" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- ================= Over other apps ================= -->
        <TextView android:id="@+id/headerOverlay" style="@style/SettingsHeader" android:text="Over other apps" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionOverlay" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/bubbleSwitch"
                android:text="Floating threat bubble" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/floatingMapSwitch"
                android:text="Floating mini map" />
        </LinearLayout>

        <!-- ================= Known cameras ================= -->
        <TextView android:id="@+id/headerMap" style="@style/SettingsHeader" android:text="Map" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionMap" android:orientation="vertical">

            <TextView android:id="@+id/mapZoomText" style="@style/SettingsLabel" android:text="Default zoom" />

            <com.google.android.material.slider.Slider
                style="@style/SettingsControl"
                android:id="@+id/mapZoomSlider"
                android:contentDescription="Default map zoom"
                android:stepSize="1"
                android:value="68"
                android:valueFrom="58"
                android:valueTo="74" />

            <Button
                android:id="@+id/mapZoomReset"
                style="@style/SettingsTextButton"
                android:text="Waze-like zoom" />

            <TextView android:id="@+id/map3dTiltText" style="@style/SettingsLabel" android:text="3D view angle" />

            <com.google.android.material.slider.Slider
                style="@style/SettingsControl"
                android:id="@+id/map3dTiltSlider"
                android:contentDescription="3D driving view angle in degrees"
                android:stepSize="5"
                android:value="50"
                android:valueFrom="30"
                android:valueTo="60" />

            <TextView style="@style/SettingsLabel" android:text="Position marker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapMarkerButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arrow" />

            <TextView android:id="@+id/mapProviderLabel" style="@style/SettingsLabel" android:text="Map provider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapProviderButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenFreeMap" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapKnownCamerasSwitch"
                android:text="Show plate, speed and red-light cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapAutoRecenterSwitch"
                android:text="Auto-recenter" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapSpeedometerSwitch"
                android:text="Speedometer" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapSpeedLimitLiveSwitch"
                android:text="Speed limit without a route" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/mapTowersSwitch"
                android:text="Show cell towers" />
        </LinearLayout>

        <!-- ================= Radar ================= -->
        <TextView android:id="@+id/headerRadar" style="@style/SettingsHeader" android:text="Radar" />
        <LinearLayout android:id="@+id/sectionRadar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/radarTopLabel" style="@style/SettingsLabel" android:text="Top of the radar" />

            <RadioGroup
                android:id="@+id/radarTopGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/radarTopFacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The way you face" />
                <RadioButton android:id="@+id/radarTopNorth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="North" />
            </RadioGroup>

            <TextView android:id="@+id/radarDotsLabel" style="@style/SettingsLabel" android:text="Dots without a direction" />

            <RadioGroup
                android:id="@+id/radarDotsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/radarDotsFixed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stay in place" />
                <RadioButton android:id="@+id/radarDotsNorth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Turn with north" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/radarNamesSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Names beside alerts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/radarSweepSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sweep line" />
        </LinearLayout>

        <!-- ================= Navigation ================= -->
        <TextView android:id="@+id/headerNav" style="@style/SettingsHeader" android:text="Navigation" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionNav" android:orientation="vertical" />

        <!-- ================= Location & traces ================= -->
        <TextView android:id="@+id/headerLocation" style="@style/SettingsHeader" android:text="Location &amp; traces" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionLocation" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/autoRecordSwitch"
                android:text="Record a trace whenever scanning starts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/traceEveryPingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log every sighting in traces" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/gpsSwitch"
                android:text="Save GPS position with matches" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/pinpointSwitch"
                android:text="Pinpoint flagged devices on the map" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pinpointAlertsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pinpoint alerts only" />

            <LinearLayout
                style="@style/SettingsControl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/mapTracesButton"
                    style="@style/SettingsTextButton"
                    android:text="Recorded traces" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= External hardware ================= -->
        <TextView android:id="@+id/headerHardware" style="@style/SettingsHeader" android:text="External hardware" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionHardware" android:orientation="vertical">

            <TextView
                android:id="@+id/espStatusText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/usbWifiText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/usbBtText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/usbBtSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Bluetooth with a USB adapter" />

            <Button
                android:id="@+id/usbWifiLogButton"
                style="@style/SettingsTextButton"
                android:text="Export a hardware log" />

            <Button
                android:id="@+id/allLogsButton"
                style="@style/SettingsTextButton"
                android:text="Export all hardware logs" />

            <TextView
                android:id="@+id/pcapText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp"
                android:text="Record what the USB WiFi adapter or V2X board hears, for Wireshark" />

            <LinearLayout
                style="@style/SettingsControl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pcapButton"
                    style="@style/SettingsTextButton"
                    android:text="Record frames" />

                <Button
                    android:id="@+id/pcapShareButton"
                    style="@style/SettingsTextButton"
                    android:visibility="gone"
                    android:text="Share last recording" />
            </LinearLayout>

            <TextView
                android:id="@+id/sdrStatusText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/ouiSpyText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/ouiSpyButton"
                style="@style/SettingsTextButton"
                android:text="Pair OUI-SPY board" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/ouiSpyRelaySwitch"
                android:text="OUI-SPY: relay everything" />

            <Button
                android:id="@+id/ouiSpyEnginesButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUI-SPY engines" />

            <TextView
                android:id="@+id/meshRadioText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/meshRadioButton"
                style="@style/SettingsTextButton"
                android:text="Pair mesh radio" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ouiSpyPhoneBleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Bluetooth scan with OUI-SPY" />

            <TextView android:id="@+id/wifiBandLabel" style="@style/SettingsLabel" android:text="USB WiFi bands" />

            <RadioGroup
                android:id="@+id/wifiBandGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/wifiBandAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="All bands" />
                <RadioButton android:id="@+id/wifiBandMostlyLow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mostly 2.4 GHz" />
                <RadioButton android:id="@+id/wifiBandLow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2.4 GHz only" />
                <RadioButton android:id="@+id/wifiBandHigh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5 and 6 GHz only" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/usbQuickClearSwitch"
                android:text="USB WiFi: end alerts out of range" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/rtl5gSwitch"
                android:text="AWUS036ACS: also scan 5 GHz" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/usbLightSwitch"
                android:text="AWUS036ACS: light blinks with traffic" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/usbLogAllSwitch"
                android:text="Log everything the USB WiFi adapter hears" />
        </LinearLayout>

        <!-- ================= RTL-SDR radio (filled in by SettingsActivity.setupRadioSection) ================= -->
        <TextView android:id="@+id/headerRadio" style="@style/SettingsHeader" android:text="RTL-SDR radio" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionRadio" android:orientation="vertical" />

        <!-- ================= Sentinel Link ================= -->
        <TextView android:id="@+id/headerLink" style="@style/SettingsHeader" android:text="Sentinel Link" />
        <LinearLayout android:id="@+id/sectionLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView
                android:id="@+id/linkStatusText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/linkSaveSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save what linked Sentinels hear" />

            <Button
                android:id="@+id/linkButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Sentinel Link" />
        </LinearLayout>

        <!-- ================= Data ================= -->
        <TextView android:id="@+id/headerData" style="@style/SettingsHeader" android:text="Data" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionData" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/SettingsControl"
                android:id="@+id/liveExportSwitch"
                android:text="Live export for other mapping apps" />

            <Button
                android:id="@+id/liveExportFolderButton"
                style="@style/SettingsTextButton"
                android:text="Choose folder" />

            <TextView
                android:id="@+id/liveExportText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="@dimen/text_caption" />

            <TextView android:id="@+id/retentionLabel" style="@style/SettingsLabel" android:text="Keep history for" />

            <EditText
                style="@style/SettingsControl"
                android:id="@+id/retentionInput"
                android:hint="90"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Button
                android:id="@+id/importHistoryButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Import device history from a file" />

            <Button
                android:id="@+id/backupSettingsButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Back up settings to a file" />

            <Button
                android:id="@+id/restoreSettingsButton"
                style="@style/SettingsOutlinedButton"
                android:text="Restore settings from a file" />

            <Button
                android:id="@+id/exportAllButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Export all devices" />

            <Button
                android:id="@+id/forgetHistoryButton"
                style="@style/SettingsTextButton"
                android:text="Forget device history" />

            <Button
                android:id="@+id/clearLogButton"
                style="@style/SettingsTextButton"
                android:text="Clear match history" />
        </LinearLayout>

        <!-- ================= Lists, tools & about ================= -->
        <TextView android:id="@+id/headerMore" style="@style/SettingsHeader" android:text="Lists, tools &amp; about" />
        <LinearLayout style="@style/SettingsControl" android:id="@+id/sectionMore" android:orientation="vertical">

            <Button
                android:id="@+id/openWatchlistButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Watchlist &amp; rules" />

            <Button
                android:id="@+id/openWhitelistButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Whitelist" />

            <Button
                android:id="@+id/ignoredSsidsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ignored network names" />

            <Button
                android:id="@+id/aboutButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="About &amp; sources" />

            <Button
                android:id="@+id/exportCrashLogButton"
                style="@style/SettingsOutlinedButton"
                android:layout_marginTop="8dp"
                android:text="Export crash log" />

            <Button
                android:id="@+id/clearCrashLogButton"
                style="@style/SettingsTextButton"
                android:text="Clear crash log" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
