<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, in foldable sections (header + section; SettingsActivity folds them and adds the ⓘ details). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= General ================= -->
        <TextView android:id="@+id/headerGeneral" style="@style/SettingsHeader" android:paddingTop="4dp" android:text="General" />
        <LinearLayout android:id="@+id/sectionGeneral" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <Button
                android:id="@+id/runSetupButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run the setup wizard again" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoUpdateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check for updates on app open" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/discreetSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discreet mode" />

            <TextView style="@style/SettingsLabel" android:text="Screen while the app is open" />

            <RadioGroup
                android:id="@+id/screenModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/screenAlwaysOn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Always on" />
                <RadioButton android:id="@+id/screenOnCharging" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="On while charging" />
                <RadioButton android:id="@+id/screenNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Normal" />
            </RadioGroup>
        </LinearLayout>

        <!-- ================= Appearance ================= -->
        <TextView android:id="@+id/headerAppearance" style="@style/SettingsHeader" android:text="Appearance" />
        <LinearLayout android:id="@+id/sectionAppearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:id="@+id/bannerLabel" style="@style/SettingsLabel" android:text="Banner image" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bannerPickButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Choose image" />

                <Button
                    android:id="@+id/bannerClearButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remove image" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= Scanning ================= -->
        <TextView android:id="@+id/headerScanning" style="@style/SettingsHeader" android:text="Scanning" />
        <LinearLayout android:id="@+id/sectionScanning" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bluetooth scanning" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/wifiSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WiFi scanning" />

            <TextView style="@style/SettingsLabel" android:text="Bluetooth scan intensity" />

            <RadioGroup
                android:id="@+id/scanModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/scanModeLowLatency" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Maximum (most battery)" />
                <RadioButton android:id="@+id/scanModeBalanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Balanced" />
                <RadioButton android:id="@+id/scanModeLowPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery saver" />
            </RadioGroup>

            <TextView android:id="@+id/intervalLabel" style="@style/SettingsLabel" android:text="WiFi scan interval (seconds)" />

            <EditText
                android:id="@+id/intervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="30"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                android:id="@+id/wifiThrottleText"
                style="@style/SettingsLabel"
                android:paddingTop="2dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/wifiThrottleButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Developer options" />

            <Button
                android:id="@+id/batteryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allow background scanning" />
        </LinearLayout>

        <!-- ================= Auto-start ================= -->
        <TextView android:id="@+id/headerAutoStart" style="@style/SettingsHeader" android:text="Auto-start" />
        <LinearLayout android:id="@+id/sectionAutoStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bootSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When the phone starts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/carAutoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="In the car" />

            <TextView
                android:id="@+id/carDevicesText"
                style="@style/SettingsLabel"
                android:paddingTop="2dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/carDevicesButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your car's Bluetooth" />
        </LinearLayout>

        <!-- ================= What to detect ================= -->
        <TextView android:id="@+id/headerDetect" style="@style/SettingsHeader" android:text="What to detect" />
        <LinearLayout android:id="@+id/sectionDetect" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/presetLabel" style="@style/SettingsLabel" android:text="Watchlist presets" />

            <CheckBox android:id="@+id/presetGlobal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Global" />
            <CheckBox android:id="@+id/presetCanada" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Canada" />
            <CheckBox android:id="@+id/presetUs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="United States" />
            <CheckBox android:id="@+id/presetFrance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="France" />
        </LinearLayout>

        <!-- ================= Alerts ================= -->
        <TextView android:id="@+id/headerAlerts" style="@style/SettingsHeader" android:text="Alerts" />
        <LinearLayout android:id="@+id/sectionAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView style="@style/SettingsLabel" android:text="Alert for matches that are at least" />

            <RadioGroup
                android:id="@+id/thresholdGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/thresholdWeak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Weak (more false alarms)" />
                <RadioButton android:id="@+id/thresholdMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probable (recommended)" />
                <RadioButton android:id="@+id/thresholdStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Strong only" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/soundSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alert sound" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/vibrateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vibration" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/radarBeepSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Radar-detector beeps (faster as it gets closer)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/detectorSoundSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Radar-detector sound (Ka / K / X tones, GPS connected)" />

            <Button
                android:id="@+id/detectorEffectButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detector sound effect" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/scanIntroSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intro sound when a scan starts" />

            <Button
                android:id="@+id/testIntroButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test intro" />

            <TextView style="@style/SettingsLabel" android:text="Re-alert the same device after (minutes)" />

            <EditText
                android:id="@+id/dedupeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="5"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <!-- ================= Voice ================= -->
        <TextView android:id="@+id/headerVoice" style="@style/SettingsHeader" android:text="Voice" />
        <LinearLayout android:id="@+id/sectionVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/voiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoken alerts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/shortVoiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Short spoken alerts" />

            <TextView style="@style/SettingsLabel" android:text="Voice speed" />

            <RadioGroup
                android:id="@+id/voiceRateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/voiceRateSlow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slow" />
                <RadioButton android:id="@+id/voiceRateNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" />
                <RadioButton android:id="@+id/voiceRateFast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voicePickButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose voice" />

                <Button
                    android:id="@+id/voiceTestButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test voice" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= Over other apps ================= -->
        <TextView android:id="@+id/headerOverlay" style="@style/SettingsHeader" android:text="Over other apps" />
        <LinearLayout android:id="@+id/sectionOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bubbleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Floating threat bubble" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/floatingMapSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Floating mini map" />
        </LinearLayout>

        <!-- ================= Trackers & followers ================= -->
        <TextView android:id="@+id/headerFollow" style="@style/SettingsHeader" android:text="Trackers &amp; followers" />
        <LinearLayout android:id="@+id/sectionFollow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/followSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warn when a device moves with me" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsLabel" android:text="For at least (minutes)" />

                    <EditText
                        android:id="@+id/followMinutesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsLabel" android:text="Over (metres)" />

                    <EditText
                        android:id="@+id/followMetersInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/trackerIgnoreText"
                style="@style/SettingsLabel"
                android:paddingTop="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/trackerIgnoreButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear ignored trackers" />
        </LinearLayout>

        <!-- ================= Known cameras ================= -->
        <TextView android:id="@+id/headerMap" style="@style/SettingsHeader" android:text="Map" />
        <LinearLayout android:id="@+id/sectionMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mapKnownCamerasSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show plate, speed and red-light cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mapTowersSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show cell towers" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/mapTracesButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recorded traces" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/headerCameras" style="@style/SettingsHeader" android:text="Known cameras" />
        <LinearLayout android:id="@+id/sectionCameras" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/knownAlprSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warn before plate-reader cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/speedCameraSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warn before speed / red-light cameras" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoCamerasSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download cameras automatically for the map area" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mapCctvSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show CCTV cameras (OpenStreetMap)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mapCctvPrivateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:text="Include private and indoor CCTV" />

            <!-- Radius of "download the cameras around me" (also the setup wizard and the map menu). -->
            <TextView
                android:id="@+id/cameraRadiusText"
                style="@style/SettingsLabel"
                android:text="Download radius: 100 km" />

            <com.google.android.material.slider.Slider
                android:id="@+id/cameraRadiusSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Camera download radius in kilometres"
                android:stepSize="10"
                android:value="100"
                android:valueFrom="10"
                android:valueTo="200" />

            <Button
                android:id="@+id/prefetchCamerasButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download cameras around me" />

            <Button
                android:id="@+id/mapDeleteCamerasButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete downloaded cameras" />

            <TextView
                android:id="@+id/prefetchCamerasText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/deflockButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="US &amp; Canada plate cameras (18 MB)" />

            <TextView
                android:id="@+id/deflockText"
                style="@style/SettingsLabel"
                android:paddingTop="0dp"
                android:textSize="12sp" />

            <!-- Cameras silenced from the map (tap a camera > Ignore alerts). -->
            <TextView
                android:id="@+id/ignoredCamerasText"
                style="@style/SettingsLabel"
                android:paddingTop="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ignoredCamerasButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alert for all ignored cameras again" />
        </LinearLayout>

        <!-- ================= Cell network ================= -->
        <TextView android:id="@+id/headerCell" style="@style/SettingsHeader" android:text="Cell network" />
        <LinearLayout android:id="@+id/sectionCell" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cellChangeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alert when the cell tower changes" />

            <TextView android:id="@+id/disable2gLabel" style="@style/SettingsLabel" android:text="Turn off 2G: best protection against fake towers" />

            <Button
                android:id="@+id/disable2gButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open SIM settings" />

            <TextView android:id="@+id/cellSecurityLabel" style="@style/SettingsLabel" android:text="Android 15+: network security alerts" />

            <Button
                android:id="@+id/cellSecurityButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open cellular security settings" />
        </LinearLayout>

        <!-- ================= External hardware ================= -->
        <TextView android:id="@+id/headerHardware" style="@style/SettingsHeader" android:text="External hardware" />
        <LinearLayout android:id="@+id/sectionHardware" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView
                android:id="@+id/espStatusText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/usbWifiText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/usbWifiLogButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export USB adapter log" />

            <TextView
                android:id="@+id/sdrStatusText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/ouiSpyText"
                style="@style/SettingsLabel"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/ouiSpyButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pair OUI-SPY board (Bluetooth)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ouiSpyRelaySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OUI-SPY: relay everything it hears" />
        </LinearLayout>

        <!-- ================= Location & traces ================= -->
        <TextView android:id="@+id/headerLocation" style="@style/SettingsHeader" android:text="Location &amp; traces" />
        <LinearLayout android:id="@+id/sectionLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoRecordSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Record a trace whenever scanning starts" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gpsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save GPS position with matches" />
        </LinearLayout>

        <!-- ================= Data ================= -->
        <TextView android:id="@+id/headerData" style="@style/SettingsHeader" android:text="Data" />
        <LinearLayout android:id="@+id/sectionData" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/retentionLabel" style="@style/SettingsLabel" android:text="Keep history for (days, 0 = forever)" />

            <EditText
                android:id="@+id/retentionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="90"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Button
                android:id="@+id/exportAllButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Export all devices (CSV, JSON, KML...)" />

            <Button
                android:id="@+id/forgetHistoryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forget device history (keeps favorites)" />

            <Button
                android:id="@+id/clearLogButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear match history" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
