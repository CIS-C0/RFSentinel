<?xml version="1.0" encoding="utf-8"?>
<!-- Two sections in one scroll: devices by address, then WiFi networks by name. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devices"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/macInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:importantForAutofill="no"
            android:hint="MAC address (AA:BB:CC:DD:EE:FF)" />

        <EditText
            android:id="@+id/noteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            android:hint="Note (optional, e.g. 'my headphones')" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to whitelist" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Network names"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="WiFi networks with a matching name are trusted like a whitelisted device. Name contains also matches part of a name: LAUSD matches LAUSD-Bus-123 and WiFi-LAUSD."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Match"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/networkMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/networkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text|textNoSuggestions"
            android:importantForAutofill="no"
            android:hint="Network name or keyword, e.g. LAUSD" />

        <Button
            android:id="@+id/addNetworkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add network name" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/networkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
